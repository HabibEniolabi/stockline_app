{
  "expo": {
    "name": "StockWave",
    "slug": "stockwave",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/stockwave-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudohabib.stockwave",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sudohabib.stockwave",
      "adaptiveIcon": {
        "foregroundImage": "./assets/stockwave-logo.png",
        "backgroundColor": "#3649D8",
        "monochromeImage": "./src/assets/stockwave-android-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow StockWave to use Face ID for secure access."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "28fc4abc-8e12-48a8-8091-e805e61c9a96"
      }
    },
    "owner": "sudohabib"
  }
}
