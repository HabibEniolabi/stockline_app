{
  "expo": {
    "name": "StockWave",
    "slug": "stockwave",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/stockwave-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudohabib.stockwave",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sudohabib.stockwave",
      "adaptiveIcon": {
        "foregroundImage": "./assets/stockwave-logo.png",
        "backgroundColor": "#3649D8",
         "monochromeImage": "./src/assets/stockwave-android-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "edf27304-1d51-4d14-a4d2-f0ef5fde2272"
      }
    }
  }
}
